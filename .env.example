# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# Never put a secret, token or Supabase key in this file.

# Base URL of the admin API. Leave empty to call the same origin
# (admin.atsscanai.com proxies /api to the backend; `npm run dev` proxies too).
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` forwards /api requests.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:5000

# Dev/preview server port on 127.0.0.1. Not 5060/5061: browsers block those.
ADMIN_PORT=5070
