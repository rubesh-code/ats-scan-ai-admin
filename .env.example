# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# Never put a secret, token or Supabase key in this file.

# Base path of the admin API. Leave empty: the dashboard must call its own
# origin, because the admin session is a same-site HttpOnly cookie. A
# same-origin path prefix is allowed; another origin is refused.
VITE_API_BASE_URL=

# Dev/preview server only: where /api/admin is forwarded - the admin auth
# service on this machine (auth-service/, loopback TCP in development).
# Must be http://127.0.0.1:<port>. Any other /api path gets 404 from the dev
# server and is never forwarded, so nothing reaches the customer backend.
# (The old ADMIN_API_PROXY_TARGET, which pointed at the customer backend, is
# refused if set.)
ADMIN_AUTH_PROXY_TARGET=http://127.0.0.1:5071

# Dev/preview server port on 127.0.0.1. Not 5060/5061: browsers block those.
# The server refuses to start if the port is taken (for example by an SSH
# tunnel to the preview); pick another one then. Open the dashboard at
# http://ats-admin.localhost:<port> and list exactly that origin in the auth
# service's ADMIN_AUTH_ALLOWED_ORIGINS.
ADMIN_PORT=5070
