# /etc/ats-admin-api/env  (root:root 0600). Never commit real values.

# The customer database. The same values as the customer backend's .env.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Zero Trust > Access > Applications > (admin.atsscanai.com):
# the team domain and the application's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Who may read data, checked after Cloudflare's own policy. Comma-separated.
ADMIN_EMAILS=

# Optional: shown on the Health page.
CUSTOMER_HEALTH_URL=http://127.0.0.1:5050/api/health

# Defaults: ADMIN_API_HOST=127.0.0.1, ADMIN_API_PORT=5080
