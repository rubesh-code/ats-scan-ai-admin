    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
